<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One source, nuget.org (ADR 0002). Varve's packages are the ones its
       maintainers publish there, under the authors field
       decision-driven-design: the brief's "decision-driven-design feed". -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Source mapping is on, so a second source added later cannot silently
       redirect an existing package id. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
