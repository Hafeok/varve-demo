<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The importer (ADRs 0004, 0006, 0008, 0010): catalog leaves read by
    Varve.JsonLd, sent as one SPARQL Update per catalog commit through
    Varve.Protocol.Client, authenticated by client credentials (ADR 0007).
  -->

  <PropertyGroup>
    <RootNamespace>VarveDemo.Importer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Varve.JsonLd" />
    <PackageReference Include="Varve.Protocol.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../VarveDemo.Snapshot/VarveDemo.Snapshot.csproj" />
  </ItemGroup>

</Project>
